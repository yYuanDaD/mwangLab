      "step": "paper_reconstruction",
      "selected": {
        "accessions": [
          "GSE242861"
        ],
        "study_parts": {
          "in_vivo_exercise_miRNA": "Gene SMART cohort, vastus lateralis biopsies at baseline and 3 h after one HIIE bout (S5.5.p1, S5.7.p1), 44 participants (24 M / 20 F), TaqMan human miRNA A+B arrays (S5.8.p1), 308 detected miRNAs; limma means model ~0 + Sex.Timepoint + BMI + Wpeak, duplicateCorrelation on participant ID (S5.9.3.p1). No GEO accession is named for these arrays (DA.p1 cites GSE242861 and Zenodo 10.5281/zenodo.8412095 only).",
          "in_vitro_miR30_overexpression": "Primary myotubes from 3 male + 3 female donors, transfected 24 h with miR-30a mimic, miR-30c mimic or scramble (S5.9.1.p1); total RNA-seq, kallisto transcript counts, DESeq2 ~ Sex * Condition, prefilter <10 RPM in <2 samples (S5.9.2.p1). This is the part deposited as GSE242861."
        },
        "primary_estimand": "Paper-wide: sex differences in skeletal-muscle miRNA expression at baseline and in the miRNA response to acute HIIE (pre vs 3 h post, by sex, sex x time interaction). Exercise is an in-vivo factor of the miRNA array data only.",
        "planned_contrasts": [
          "miRNA arrays: male vs female at baseline (S2.1.p1; 148 miRNAs)",
          "miRNA arrays: post vs pre exercise in females (S2.2.p1; 4 up, 0 down)",
          "miRNA arrays: post vs pre exercise in males (S2.2.p1; 148 up, 2 down)",
          "miRNA arrays: sex x exercise interaction (S2.2.p1; 111 miRNAs)",
          "RNA-seq (GSE242861): male vs female donor cells, scramble (S2.7.p1; 26 genes)",
          "RNA-seq (GSE242861): miR-30a vs scramble in males (18 up/23 down) and females (16 up/23 down) (S2.7.p2)",
          "RNA-seq (GSE242861): miR-30c vs scramble in males (13 up/12 down) and females (10 up/11 down) (S2.8.p1)"
        ],
        "factors": {
          "sex": [
            "male",
            "female"
          ],
          "treatment": [
            "scramble",
            "miR-30a",
            "miR-30c"
          ],
          "donor": "6 donor cell lines, each with all three treatments"
        },
        "inclusion": "18 RNA-seq libraries = 6 donors x 3 treatments; no exercise or time factor in the RNA-seq",
        "repeated_measure_unit": "donor cell line (RNA-seq); participant (arrays)",
        "paper_method": "RNA-seq: DESeq2 ~ Sex * Condition on kallisto counts; arrays: limma mixed model with duplicateCorrelation",
        "paper_threshold": {
          "metric": "FDR",
          "cutoff": 0.05,
          "effect_metric": null,
          "effect_cutoff": null,
          "source_locator": "S5.9.3.p3; FIG4; FIG5"
        }
      },
      "reason": "The exercise estimand of the paper lives entirely in the TaqMan miRNA array data from in-vivo biopsies (S5.8.p1, S5.9.3.p1). The only GEO series cited (DA.p1) is GSE242861, whose 18 samples are primary myotube cultures transfected with miR-30a/miR-30c mimics or scramble (S5.9.1.p1, S5.9.2.p1); there is no exercise, time or biopsy factor in it. FDR < 0.05 with no fold-change rule (S5.9.3.p3, FIG4, FIG5).",
