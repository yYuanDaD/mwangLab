# Evaluated deployment default: DeepSeek V4 Pro.
BIOAGENT_LLM_PROVIDER=deepseek
BIOAGENT_SEACDM_LLM_PROVIDER=anthropic
# Prevent long structured JSON/tool payloads from silently stopping at a small provider default.
BIOAGENT_STRUCTURED_MAX_TOKENS=16384

# Keep both keys so switching back only requires changing BIOAGENT_LLM_PROVIDER.
CLAUDE_API_KEY=

# Optional: improves Semantic Scholar paper-search rate limits.
S2_API_KEY=

# DeepSeek V4 via its Anthropic-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
